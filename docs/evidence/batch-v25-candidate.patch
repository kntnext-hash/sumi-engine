+        public void SeventeenDirtyTilesUseThreeUploadsAndDoNotCopyUnusedSlots()
+        {
+            if (!DirtyInkSurface.IsSupported) Assert.Ignore("GPU region copy unavailable.");
+            using (var surface = new DirtyInkSurface(256, 128))
